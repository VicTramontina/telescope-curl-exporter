{
  "manifest_version": 3,
  "name": "Telescope cURL Exporter",
  "description": "Adds a 'Copy as cURL' button to Laravel Telescope HTTP Client Request detail pages.",
  "version": "1.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "telescope-curl-exporter@victramontina",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["clipboardWrite"],
  "host_permissions": ["<all_urls>"]
}
